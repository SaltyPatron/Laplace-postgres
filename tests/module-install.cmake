file(REAL_PATH "${BUILD}" build_root)
set(work "${build_root}/module-install-test")
cmake_path(IS_PREFIX build_root "${work}" NORMALIZE contained)
if(NOT contained)
  message(FATAL_ERROR "Module install fixture must stay inside the declared build")
endif()
file(MAKE_DIRECTORY "${work}/build")
set(name "laplace_0123456789abcdefabcd")
set(MODULE_INDEX "${work}/build/laplace_module.txt")
set(MODULE_BUILD "${work}/build")
set(MODULE_SUFFIX ".module")
file(WRITE "${MODULE_INDEX}" "${name}\n")
file(WRITE "${MODULE_BUILD}/${name}${MODULE_SUFFIX}" "matching Native generation\n")
set(CMAKE_INSTALL_PREFIX "${work}/product")
set(MODULE_LIBDIR "lib")
include("${SOURCE}/cmake/InstallModule.cmake")
set(relative "$ENV{DESTDIR}${work}/product/lib/${name}${MODULE_SUFFIX}")
if(NOT EXISTS "${relative}")
  message(FATAL_ERROR "The embedding product's relative library directory lost its Native generation")
endif()
set(MODULE_LIBDIR "${work}/absolute")
include("${SOURCE}/cmake/InstallModule.cmake")
set(absolute "$ENV{DESTDIR}${work}/absolute/${name}${MODULE_SUFFIX}")
if(NOT EXISTS "${absolute}")
  message(FATAL_ERROR "The standalone absolute library directory lost its Native generation")
endif()
if(CMAKE_HOST_UNIX)
  set(previous_destdir "$ENV{DESTDIR}")
  set(ENV{DESTDIR} "${work}/stage")
  set(CMAKE_INSTALL_PREFIX "/opt/laplace")
  set(MODULE_LIBDIR "lib")
  include("${SOURCE}/cmake/InstallModule.cmake")
  if(NOT EXISTS "${work}/stage/opt/laplace/lib/${name}${MODULE_SUFFIX}")
    message(FATAL_ERROR "The staged product package lost its Native generation")
  endif()
  set(ENV{DESTDIR} "${previous_destdir}")
endif()
file(REMOVE_RECURSE "${work}")
