# Reconfigure the real candidate twice. No database or installed files are used.
foreach(required SOURCE BUILD)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing configure setting ${required}")
  endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${SOURCE}" -B "${BUILD}"
                COMMAND_ERROR_IS_FATAL ANY OUTPUT_QUIET)
file(GLOB outputs "${BUILD}/extension/laplace--*.sql")
list(APPEND outputs "${BUILD}/laplace_current_api.h" "${BUILD}/laplace_function_bindings.h")
list(LENGTH outputs count)
if(count LESS 3)
  message(FATAL_ERROR "Candidate generated no extension SQL")
endif()
foreach(path IN LISTS outputs)
  file(SHA256 "${path}" digest)
  file(TIMESTAMP "${path}" timestamp "%s" UTC)
  string(APPEND before "${path}\t${digest}\t${timestamp}\n")
endforeach()
# CMake timestamps have one-second resolution; an immediate rerun can conceal writes.
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1 COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${SOURCE}" -B "${BUILD}"
                COMMAND_ERROR_IS_FATAL ANY OUTPUT_QUIET)
foreach(path IN LISTS outputs)
  file(SHA256 "${path}" digest)
  file(TIMESTAMP "${path}" timestamp "%s" UTC)
  string(APPEND after "${path}\t${digest}\t${timestamp}\n")
endforeach()
if(NOT "${before}" STREQUAL "${after}")
  message(FATAL_ERROR "Unchanged configure rewrote generated extension inputs")
endif()
message(STATUS "Unchanged configure preserves ${count} generated inputs")
