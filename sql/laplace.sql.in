CREATE TYPE @extschema@.blake3 (
    INTERNALLENGTH = 16,
    INPUT = @extschema@.blake3_in,
    OUTPUT = @extschema@.blake3_out,
    RECEIVE = @extschema@.blake3_recv,
    SEND = @extschema@.blake3_send,
    ALIGNMENT = char,
    STORAGE = plain
);

