CREATE FUNCTION @extschema@.laplace_path_enrich_ewkb(recorded @extschema:postgis@.geometry, incoming @extschema:postgis@.geometry) RETURNS bytea
    LANGUAGE c IMMUTABLE STRICT PARALLEL SAFE
    AS 'MODULE_PATHNAME', 'laplace_path_enrich_ewkb';

CREATE FUNCTION @extschema@.laplace_path_enrich(recorded @extschema:postgis@.geometry, incoming @extschema:postgis@.geometry) RETURNS @extschema:postgis@.geometry
    LANGUAGE sql IMMUTABLE STRICT PARALLEL SAFE
    BEGIN ATOMIC
 SELECT @extschema:postgis@.st_setsrid(@extschema:postgis@.st_geomfromewkb(@extschema@.laplace_path_enrich_ewkb(recorded, incoming)), @extschema:postgis@.st_srid(recorded)) AS st_setsrid
   WHERE (@extschema:postgis@.st_srid(recorded) = @extschema:postgis@.st_srid(incoming));
END;

