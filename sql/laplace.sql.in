    OPERATOR 8 @extschema@.^@(@extschema:postgis@.geometry,@extschema@.blake3) ,
    OPERATOR 9 @extschema@.@^(@extschema:postgis@.geometry,@extschema@.blake3) ,
    FUNCTION 1 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) byteacmp(bytea,bytea) ,
    FUNCTION 4 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_gin_consistent(internal,smallint,@extschema@.blake3[],integer,internal,internal,internal,internal) ,
    FUNCTION 6 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_gin_triconsistent(internal,smallint,@extschema@.blake3[],integer,internal,internal,internal);

CREATE OPERATOR CLASS @extschema@.laplace_path_ops
    FOR TYPE @extschema:postgis@.geometry USING gin FAMILY @extschema@.laplace_path_ops AS
    STORAGE bytea ,
    FUNCTION 2 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_gin_extract_value(@extschema:postgis@.geometry,internal,internal) ,
    FUNCTION 3 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_gin_extract_query(@extschema@.blake3[],internal,smallint,internal,internal,internal,internal);

-- @laplace_path_set_match@

CREATE OPERATOR FAMILY @extschema@.laplace_point4d_ops USING gist;
ALTER OPERATOR FAMILY @extschema@.laplace_point4d_ops USING gist ADD
    OPERATOR 15 @extschema@.<~>(@extschema:postgis@.geometry,@extschema:postgis@.geometry) FOR ORDER BY pg_catalog.float_ops ,
    FUNCTION 3 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_point4d_gist_compress(internal) ,
    FUNCTION 8 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_point4d_gist_distance(internal,@extschema:postgis@.geometry,smallint,oid,internal) ,
    FUNCTION 11 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_point4d_gist_sortsupport(internal);

CREATE OPERATOR CLASS @extschema@.laplace_point4d_ops
    FOR TYPE @extschema:postgis@.geometry USING gist FAMILY @extschema@.laplace_point4d_ops AS
    STORAGE @extschema@.laplace_box4d ,
    FUNCTION 1 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_point4d_gist_consistent(internal,@extschema:postgis@.geometry,smallint,oid,internal) ,
    FUNCTION 2 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_point4d_gist_union(internal,internal) ,
    FUNCTION 5 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_point4d_gist_penalty(internal,internal,internal) ,
    FUNCTION 6 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_point4d_gist_picksplit(internal,internal) ,
    FUNCTION 7 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_point4d_gist_same(@extschema@.laplace_box4d,@extschema@.laplace_box4d,internal);

CREATE OPERATOR FAMILY @extschema@.laplace_traj_ops USING gist;
ALTER OPERATOR FAMILY @extschema@.laplace_traj_ops USING gist ADD
    OPERATOR 15 laplace.<->(@extschema:postgis@.geometry,@extschema:postgis@.geometry) FOR ORDER BY pg_catalog.float_ops ,
    FUNCTION 3 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_path4d_gist_compress(internal) ,
    FUNCTION 8 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_path4d_gist_distance(internal,@extschema:postgis@.geometry,smallint,oid,internal) ,
    FUNCTION 11 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_point4d_gist_sortsupport(internal);

CREATE OPERATOR CLASS @extschema@.laplace_traj_ops
    FOR TYPE @extschema:postgis@.geometry USING gist FAMILY @extschema@.laplace_traj_ops AS
    STORAGE @extschema@.laplace_path4d_key ,
    FUNCTION 1 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_point4d_gist_consistent(internal,@extschema:postgis@.geometry,smallint,oid,internal) ,
    FUNCTION 2 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_path4d_gist_union(internal,internal) ,
    FUNCTION 5 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_point4d_gist_penalty(internal,internal,internal) ,
    FUNCTION 6 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_path4d_gist_picksplit(internal,internal) ,
    FUNCTION 7 (@extschema:postgis@.geometry, @extschema:postgis@.geometry) @extschema@.laplace_path4d_gist_same(@extschema@.laplace_path4d_key,@extschema@.laplace_path4d_key,internal);

-- Canonical retained content; partitions are a storage detail of these four tables.

CREATE TABLE @extschema@.entity (
    id @extschema@.blake3 NOT NULL,
    tier smallint NOT NULL,
    coord @extschema:postgis@.geometry(PointZM) NOT NULL,
    hilbert bigint NOT NULL,
    mask bit(64) DEFAULT '0'::bit(64) NOT NULL,
    CONSTRAINT entity_mask_valid CHECK (@extschema@.laplace_mask_valid(mask))
)
PARTITION BY RANGE (id);

CREATE TABLE @extschema@.physicality (
    entity @extschema@.blake3 NOT NULL,
    tier smallint NOT NULL,
    hilbert bigint NOT NULL,
    path @extschema:postgis@.geometry NOT NULL,
    mask bit(64) DEFAULT '0'::bit(64) NOT NULL,
    CONSTRAINT physicality_mask_valid CHECK (@extschema@.laplace_mask_valid(mask))
)
PARTITION BY RANGE (entity);

CREATE TABLE @extschema@.witness (
    id @extschema@.blake3 NOT NULL,
    lineage @extschema@.blake3,
    trust double precision NOT NULL
);

CREATE TABLE @extschema@.consensus (
    claim @extschema@.blake3 NOT NULL,
    rating double precision NOT NULL,
    deviation double precision NOT NULL,
    volatility double precision NOT NULL,
    matches bigint NOT NULL
)
PARTITION BY RANGE (claim);

ALTER TABLE @extschema@.entity
    ADD CONSTRAINT entity_pkey PRIMARY KEY (id);

ALTER TABLE @extschema@.physicality
    ADD CONSTRAINT physicality_pkey PRIMARY KEY (entity);

ALTER TABLE @extschema@.witness
    ADD CONSTRAINT witness_pkey PRIMARY KEY (id);

ALTER TABLE @extschema@.consensus
    ADD CONSTRAINT consensus_pkey PRIMARY KEY (claim);

DO $partitions$
DECLARE i integer; lo text; hi text; suffix text;
BEGIN
 FOR i IN 0..255 LOOP
  suffix:=pg_catalog.lpad(pg_catalog.to_hex(i),2,'0');
  lo:=CASE WHEN i=0 THEN 'MINVALUE' ELSE pg_catalog.quote_literal(suffix||pg_catalog.repeat('0',30)) END;
  hi:=CASE WHEN i=255 THEN 'MAXVALUE' ELSE pg_catalog.quote_literal(pg_catalog.lpad(pg_catalog.to_hex(i+1),2,'0')||pg_catalog.repeat('0',30)) END;
  EXECUTE pg_catalog.format('CREATE TABLE @extschema@.entity_%s PARTITION OF @extschema@.entity FOR VALUES FROM (%s) TO (%s)',suffix,lo,hi);
  EXECUTE pg_catalog.format('CREATE TABLE @extschema@.physicality_%s PARTITION OF @extschema@.physicality FOR VALUES FROM (%s) TO (%s) WITH (parallel_workers=0)',suffix,lo,hi);
 END LOOP;
 FOR i IN 0..15 LOOP
  suffix:=pg_catalog.to_hex(i);
  lo:=CASE WHEN i=0 THEN 'MINVALUE' ELSE pg_catalog.quote_literal(suffix||pg_catalog.repeat('0',31)) END;
  hi:=CASE WHEN i=15 THEN 'MAXVALUE' ELSE pg_catalog.quote_literal(pg_catalog.to_hex(i+1)||pg_catalog.repeat('0',31)) END;
  EXECUTE pg_catalog.format('CREATE TABLE @extschema@.consensus_%s PARTITION OF @extschema@.consensus FOR VALUES FROM (%s) TO (%s) WITH (fillfactor=80)',suffix,lo,hi);
 END LOOP;
END $partitions$;
ALTER TABLE @extschema@.physicality ALTER COLUMN path SET STATISTICS 0;
CREATE INDEX entity_hilbert ON @extschema@.entity(hilbert);
CREATE INDEX entity_coord ON @extschema@.entity USING gist(coord @extschema@.laplace_point4d_ops);
CREATE INDEX physicality_paths ON @extschema@.physicality USING gin(path @extschema@.laplace_path_ops,mask @extschema@.laplace_mask_ops) WITH(gin_pending_list_limit=32768);
ALTER TABLE @extschema@.physicality ADD CONSTRAINT physicality_entity_fkey FOREIGN KEY(entity) REFERENCES @extschema@.entity(id);
DO $dump_content$
DECLARE item record;
BEGIN
 FOR item IN SELECT c.oid FROM pg_catalog.pg_class c
  JOIN pg_catalog.pg_depend d ON d.classid='pg_catalog.pg_class'::pg_catalog.regclass AND d.objid=c.oid
  JOIN pg_catalog.pg_extension e ON e.oid=d.refobjid AND d.refclassid='pg_catalog.pg_extension'::pg_catalog.regclass
  WHERE e.extname='laplace' AND d.deptype='e' AND c.relkind='r'
 LOOP PERFORM pg_catalog.pg_extension_config_dump(item.oid,''); END LOOP;
END $dump_content$;

-- @laplace_api@

-- @laplace_operations@

COMMENT ON FUNCTION @extschema@.laplace_attest_series(pending regclass, changed @extschema@.blake3[]) IS 'Publish the shared Native series snapshot under ordered consensus bucket locks. Preserve cumulative replay, signed trust, dependence folding and removal of claims without evidence.';

COMMENT ON FUNCTION @extschema@.laplace_claims_each(ids @extschema@.blake3[], fan bigint, bits smallint[], refuse @extschema@.blake3[], OUT i bigint, OUT entity @extschema@.blake3, OUT path @extschema:postgis@.geometry, OUT rating double precision, OUT deviation double precision, OUT volatility double precision, OUT matches bigint) IS 'Native indexed claim set for every input occurrence, with the caller-selected fan or NULL for all responders. Virtual Tier-0 identities need no entity row.';

COMMENT ON FUNCTION @extschema@.laplace_clean_pending_list(index_id regclass) IS 'Clean only an extension-owned physicality GIN index for an invoker with INSERT and UPDATE on its partition or parent; does not require canonical-table TRUNCATE or index ownership.';

COMMENT ON FUNCTION @extschema@.laplace_clean_stage(paths regclass) IS 'Drain GIN pending entries for copied path IDs, routing through Native partition bounds and the existing restricted maintenance authority. Returns cleaned pending pages; no input cutoff or public path scan.';

COMMENT ON FUNCTION @extschema@.laplace_contained_series(trunks @extschema@.blake3[], OUT trunk @extschema@.blake3, OUT claim @extschema@.blake3, OUT games double precision, OUT tokens double precision, OUT score double precision, OUT "position" integer, OUT dependence_root @extschema@.blake3, OUT dependence_trust double precision) IS 'Read Native claim series below persisted trunks using bounded SPI frontier sets. Shares edge, RLE, outcome and dependence-class tallying with upward containment; no source bytes, standings mutation or witness publication.';

COMMENT ON FUNCTION @extschema@.laplace_enrich_stage(input regclass, target regclass) IS 'Enrich existing Native carriers from an UNLOGGED stage set, routing copied keys by destination partition with work_mem-sized SPI buffers. Parent-table privileges, guards and transaction boundaries are preserved.';

COMMENT ON FUNCTION @extschema@.laplace_ensure_stage() IS 'Prepare three UNLOGGED column templates once; readiness does not loop over partitions, scan pending rows, or truncate data.';

COMMENT ON FUNCTION @extschema@.laplace_labels(ids @extschema@.blake3[], OUT i bigint, OUT entity @extschema@.blake3, OUT content text) IS 'Native selected-ID labels in one DAG context: Unicode text and ordered tuple/run structure. Other structural roles and missing realizations retain their canonical identity; package bodies are not reconstructed to label them.';

COMMENT ON FUNCTION @extschema@.laplace_mask_merge(a bit, b bit) IS 'Native checked bitwise OR: combine disjoint fields and row-role flags; reject conflicting enum values.';

COMMENT ON FUNCTION @extschema@.laplace_mask_slot(bank text, value text) IS '64-bit carrier encoding of a frozen bank slot. For exact enum filtering use (mask & @extschema@.laplace_mask_field(bank)) = @extschema@.laplace_mask_slot(bank, value).';

COMMENT ON FUNCTION @extschema@.laplace_merge_stage(entities regclass, paths regclass, OUT entity_rows bigint, OUT physicality_rows bigint, OUT updated_rows bigint) IS 'Consume a paired formed batch in Hilbert order. Retain optional Native client presence classifications; verify only claimed-new IDs once for concurrent overlap; insert absent IDs and enrich existing carriers. No global apply lock, destination anti-join or conflict-driven insertion.';

COMMENT ON FUNCTION @extschema@.laplace_present_ids(ids @extschema@.blake3[], OUT id @extschema@.blake3, OUT ordinal bigint) IS 'Indexed stored-ID presence for a complete client frontier. Native partition routing and btree array scans preserve input occurrences without per-ID executor/partition restarts; Tier-0 membership belongs to the client cache.';

COMMENT ON FUNCTION @extschema@.laplace_recoordinate(apply boolean, OUT entity_rows bigint, OUT physicality_rows bigint) IS 'Explicit canonical DAG projection audit or atomic repair, including stored canonical scalar atoms; rejects unknown/non-atomic leaves and preserves content IDs, paths, masks, witnesses and consensus.';

COMMENT ON FUNCTION @extschema@.laplace_series(roots @extschema@.blake3[], games bigint[], scores double precision[], trusts double precision[], OUT rating double precision, OUT deviation double precision, OUT volatility double precision, OUT matches bigint, OUT witnesses bigint) IS 'Native rooted Glicko-2 posterior: games and mean outcomes, bounded trust, shared source uncertainty. Complete evidence is recomputed from the stock prior; input permutations and replay are identical.';

COMMENT ON FUNCTION @extschema@.laplace_series_snapshot(pending regclass, changed @extschema@.blake3[], OUT claim @extschema@.blake3, OUT rating double precision, OUT deviation double precision, OUT volatility double precision, OUT matches bigint) IS 'Read-only Native standing candidates from cumulative stage observations and registered containment evidence. No public mutation or consensus advisory lock. A selected claim with no evidence returns a NULL standing.';

COMMENT ON FUNCTION @extschema@.laplace_stage_snapshot(pending regclass, changed regclass, OUT claim @extschema@.blake3, OUT rating double precision, OUT deviation double precision, OUT volatility double precision, OUT matches bigint) IS 'One Native calculation for the supplied stage-resident claim set, sharing indexed carrier proofs, witness registry, lineage resolution and containment DAG; no fixed claim slicing or recursive SQL.';

COMMENT ON FUNCTION @extschema@.laplace_text_batch(ids @extschema@.blake3[], OUT i bigint, OUT entity @extschema@.blake3, OUT content text) IS 'Realize selected Native identities together, preserving input occurrences and runs while reading shared DAG descendants once. Transfer windows follow work_mem and PostgreSQL array capacity.';

COMMENT ON FUNCTION @extschema@.laplace_text_id(text) IS 'Canonical Native UAX #29 codepoint/grapheme/word/phrase composition, identical to Engine text ingestion. Empty content returns NULL; source bytes are not normalized.';

COMMENT ON OPERATOR laplace.<-> (@extschema:postgis@.geometry, @extschema:postgis@.geometry) IS 'Native 4D discrete Frechet distance, equal to chord distance for two points. Use OPERATOR(laplace.<->).';
