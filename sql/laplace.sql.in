CREATE FUNCTION @extschema@.laplace_hilbert_ranges_flat(@extschema:postgis@.geometry, @extschema:postgis@.geometry, integer) RETURNS bigint[]
    LANGUAGE c IMMUTABLE STRICT PARALLEL SAFE
    AS 'MODULE_PATHNAME', 'laplace_hilbert_ranges_flat';

CREATE FUNCTION @extschema@.laplace_hilbert_ranges(lo @extschema:postgis@.geometry, hi @extschema:postgis@.geometry, budget integer DEFAULT 64) RETURNS TABLE(lo bigint, hi bigint)
    LANGUAGE sql IMMUTABLE STRICT ROWS 64 PARALLEL SAFE
    BEGIN ATOMIC
 SELECT s.f[((2 * i.i) - 1)] AS f,
     s.f[(2 * i.i)] AS f
    FROM ( SELECT @extschema@.laplace_hilbert_ranges_flat(laplace_hilbert_ranges.lo, laplace_hilbert_ranges.hi, laplace_hilbert_ranges.budget) AS f) s,
     LATERAL generate_series(1, (COALESCE(array_length(s.f, 1), 0) / 2)) i(i);
END;

