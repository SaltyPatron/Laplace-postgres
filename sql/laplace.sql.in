-- Current Laplace installation. Historical development migrations are not an installation path.
\echo Use "CREATE EXTENSION laplace" to load this file. \quit

-- Auxiliary operator and working namespaces are shared only by explicit object names.
DO $namespaces$ BEGIN
 IF pg_catalog.to_regnamespace('laplace') IS NULL THEN CREATE SCHEMA laplace; END IF;
END $namespaces$;

CREATE TYPE @extschema@.blake3;

CREATE FUNCTION @extschema@.blake3_in(cstring) RETURNS @extschema@.blake3
    LANGUAGE c IMMUTABLE STRICT PARALLEL SAFE
    AS 'MODULE_PATHNAME', 'blake3_in';

